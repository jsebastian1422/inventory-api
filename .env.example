# PostgreSQL (usado por docker-compose y por la API)
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change_me
POSTGRES_DB=inventory
# Puerto publicado en el host; cambia si 5432 esta ocupado
POSTGRES_PORT=5432
# Host desde el que la API (corriendo en el host) llega a la BD
POSTGRES_HOST=localhost

# API core
API_HOST=0.0.0.0
API_PORT=3000

# CORS (core e identity): origenes exactos del frontend separados por comas, sin ruta ni "/" final.
# Vacio o ausente = sin CORS.
CORS_ORIGINS=http://localhost:5173

# Servicio identity
IDENTITY_API_PORT=3001
# Claves ES256 para firmar/verificar el JWT. Genera un par local con: npm run keys:generate
# identity usa ambas claves; core solo la publica (JWT_PUBLIC_KEY / JWT_PUBLIC_KEY_PATH).
# Usa la ruta (relativa al directorio del servicio) o el contenido PEM (con \n literales).
JWT_PRIVATE_KEY_PATH=../../keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=../../keys/jwt-public.pem
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# Vigencias: numero + s|m|h|d
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Sesion web (identity, ADR-0007): la cookie del refresh es Secure salvo que lo desactives.
# En desarrollo local por http ponlo en false; en cualquier otro entorno dejalo en true.
SESSION_COOKIE_SECURE=false
# Limite de logins fallidos (identity): por correo, por IP y ventana
LOGIN_MAX_ATTEMPTS_EMAIL=5
LOGIN_MAX_ATTEMPTS_IP=20
LOGIN_ATTEMPT_WINDOW=15m
# Recuperacion de contrasena (identity, ADR-0008)
PASSWORD_RESET_TTL=30m
# URL publica de inventory-web (el correo enlaza a ${WEB_APP_URL}/restablecer#token=...)
WEB_APP_URL=http://localhost:5173
# SMTP: en desarrollo, Mailpit (docker compose up -d mailpit; bandeja en http://localhost:8025).
# Sin SMTP_HOST no se envian correos. Con SMTP_HOST, WEB_APP_URL y SMTP_FROM son obligatorios.
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_FROM=Inventario <no-reply@inventario.local>
# Puertos de Mailpit publicados en el host
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025

# Pruebas de integracion: base separada en el mismo contenedor (no la de desarrollo)
POSTGRES_TEST_DB=inventory_test
# El administrador inicial NO va aqui: pasalo en la linea de comandos (ver README).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
