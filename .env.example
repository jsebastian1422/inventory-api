# PostgreSQL (usado por docker-compose y por la API)
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change_me
POSTGRES_DB=inventory
# Puerto publicado en el host; cambia si 5432 esta ocupado
POSTGRES_PORT=5432
# Host desde el que la API (corriendo en el host) llega a la BD
POSTGRES_HOST=localhost

# API core
API_HOST=0.0.0.0
API_PORT=3000
